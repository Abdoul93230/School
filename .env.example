# Variables d'environnement SchoolOS
# Copiez ce fichier en .env.local et adaptez les valeurs.

# URL de l'API backend SchoolOS (formulaires, candidatures, notifications)
VITE_API_URL="https://api.schoolos.africa"

# Clé API pour les services IA (détection du décrochage scolaire, appréciations automatiques)
VITE_AI_API_KEY=""

# URL du Web App Google Apps Script qui enregistre les candidatures Fondateurs
# dans Google Sheets (voir google-apps-script.js + section « Candidatures » du README).
# Laisser vide pour le mode démo hors-ligne (aucun envoi, formulaire fonctionnel).
VITE_APPS_SCRIPT_URL="https://script.google.com/macros/s/VOTRE_ID_ICI/exec"

# URL publique du site (liens, callbacks)
VITE_APP_URL="https://schoolos.africa"
